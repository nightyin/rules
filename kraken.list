DOMAIN,inquiry.withpersona.com
DOMAIN,sdk.nsureapi.com
DOMAIN,sdk-service.nsureapi.com
DOMAIN,sdk-error-manager-service.nsureapi.com
DOMAIN,metrics.nsureapi.com

# Payment component referenced by the Pro bundle.
DOMAIN,checkout-web-components.checkout.com
# Additional trading endpoint permitted by the Pro CSP.
DOMAIN,optionsapi.kf0.io

# Configuration / fallback endpoints referenced by the bundled Statsig SDK.
DOMAIN,api.statsigcdn.com
DOMAIN,featureassets.org
DOMAIN,prodregistryv2.org
DOMAIN,statsigapi.net

# Consent script directly loaded by the official pages.
